# Copy to .env.local (already gitignored) to point this frontend at a real
# gauge-api instance. Both of these are server-only — read by Route Handlers
# under app/api/gauge/, never sent to the browser. Without them, the app
# still works: every backend-backed surface falls back to its illustrative
# local data (see hooks/useLiveTape.ts).

# Base URL of a running gauge-api. Defaults to http://127.0.0.1:8080 if unset.
GAUGE_API_URL=http://127.0.0.1:8080

# Must match the GAUGE_API_TOKEN gauge-api was started with (see its
# main.rs — it refuses to start without one). Proves this frontend is an
# authorized caller; it is not per-user auth (gauge-api doesn't have that
# yet — every request acts as the fixed DEMO_USER_ID in lib/api/gaugeConfig.ts).
GAUGE_API_TOKEN=dev-token
